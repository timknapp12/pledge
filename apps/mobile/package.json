{
  "name": "@pledge/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "lint": "eslint .",
    "start": "expo start",
    "android": "expo start --android",
    "build:dev:a": "eas build --platform android --profile development",
    "build:dev:i": "eas build --platform ios --profile development",
    "build:dev": "eas build --platform all --profile development",
    "build:preview:a": "eas build --platform android --profile preview",
    "build:preview:i": "eas build --platform ios --profile preview",
    "build:preview": "eas build --platform all --profile preview",
    "build:prod:a": "eas build --platform android --profile production",
    "build:prod:i": "eas build --platform ios --profile production",
    "build:prod": "eas build --platform all --profile production",
    "update:preview": "DEPLOY_ENVIRONMENT=preview eas update --branch preview --environment preview --clear-cache",
    "update:prod": "DEPLOY_ENVIRONMENT=production eas update --branch production --environment production --clear-cache",
    "update:preview:nocache": "DEPLOY_ENVIRONMENT=preview eas update --branch preview --environment preview",
    "update:prod:nocache": "DEPLOY_ENVIRONMENT=production eas update --branch production --environment production"
  },
